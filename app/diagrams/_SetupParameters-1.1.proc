        <defaultValue xmi:type="expression:Expression" xmi:id="_cg5jQCuOEe6G4poBkvcmiw" name="init_smtp()" content="def smtp = [:]&#xD;&#xA;&#xD;&#xA;smtp.smtpHost = smtpHost&#xD;&#xA;smtp.smtpUserName = smtpUserName&#xD;&#xA;smtp.smtpFrom = smtpFrom&#xD;&#xA;smtp.smtpPassword = smtpPassword&#xD;&#xA;smtp.smtpSSL = String.valueOf(smtpSSL)&#xD;&#xA;smtp.smtpPort = String.valueOf(smtpPort)&#xD;&#xA;smtp.smtpTLS = String.valueOf(smtpTLS)&#xD;&#xA;smtp.smtpTo = smtpTo&#xD;&#xA;smtp.mailUsername = smtpUserName&#xD;&#xA;smtp.mailPassword = smtpUserName&#xD;&#xA;smtp.mailHost = smtpHost&#xD;&#xA;smtp.mailPort = String.valueOf(smtpPort)&#xD;&#xA;smtp.smtp_host = smtpHost&#xD;&#xA;smtp.emailPassword = smtpPassword&#xD;&#xA;smtp.emailServerPassword = smtpPassword&#xD;&#xA;smtp.userMail = smtpUserName&#xD;&#xA;smtp.email = smtpTo&#xD;&#xA;smtp.smtpUseCustomerEmail=  smtpUseCustomerEmail.toString()&#xD;&#xA;&#xD;&#xA;return smtp" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.Object">
