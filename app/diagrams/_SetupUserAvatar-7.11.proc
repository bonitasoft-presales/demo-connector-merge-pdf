                <expression xmi:type="expression:Expression" xmi:id="_GDbh1p5rEem2CITl3-3gWg" name="setIconToUser()" content="import org.bonitasoft.engine.bpm.document.Document&#xA;import org.bonitasoft.engine.identity.User&#xA;import org.bonitasoft.engine.identity.UserSearchDescriptor&#xA;import org.bonitasoft.engine.identity.UserUpdater&#xA;import org.bonitasoft.engine.search.SearchOptionsBuilder&#xA;import org.bonitasoft.engine.search.SearchResult&#xA;&#xA;def identityApi = apiAccessor.getIdentityAPI()&#xA;def processApi = apiAccessor.getProcessAPI()&#xA;&#xA;SearchOptionsBuilder builder = new SearchOptionsBuilder(0, 1)&#xA;builder.filter(UserSearchDescriptor.USER_NAME, userName)&#xA;final SearchResult&lt;User> userResults = identityApi.searchUsers(builder.done())&#xA;&#xA;Document foundIcon&#xA;if (userResults.getCount()==1){&#xA;        def users = userResults.getResult()&#xA;        User user =  users.get(0)&#xA;        icons.each{&#xA;            Document doc = it as Document&#xA;            if ((&quot;${userName}.jpg&quot; as String).equals( doc.contentFileName)){&#xA;                foundIcon = doc&#xA;            }&#xA;        }&#xA;        if (foundIcon){&#xA;            UserUpdater userUpdater = new UserUpdater()&#xA;            processApi.getDocumentContent(foundIcon.contentStorageId)&#xA;            userUpdater.setIcon(foundIcon.contentFileName, processApi.getDocumentContent(foundIcon.contentStorageId))&#xA;            identityApi.updateUser(user.id, userUpdater)&#xA;        }else{&#xA;            processApi.addProcessComment(processInstanceId, &quot;NO profile picture found for for user ${user.userName}&quot;)&#xA;        }&#xA;        &#xA;}&#xA;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.Object" returnTypeFixed="true">
                  <referencedElements xmi:type="expression:Expression" xmi:id="_HzQ80AyvEeyVjv_m2zu74w" name="apiAccessor" content="apiAccessor" type="TYPE_ENGINE_CONSTANT" returnType="com.bonitasoft.engine.api.APIAccessor"/>
                  <referencedElements xmi:type="process:Data" xmi:id="_HzQ80QyvEeyVjv_m2zu74w" name="userName" dataType="_TWyToZ5ZEematvoC-gpn8Q"/>
                  <referencedElements xmi:type="expression:Expression" xmi:id="_HzQ80gyvEeyVjv_m2zu74w" name="processInstanceId" content="processInstanceId" type="TYPE_ENGINE_CONSTANT" returnType="java.lang.Long"/>
                  <referencedElements xmi:type="process:Document" xmi:id="_HzQ80wyvEeyVjv_m2zu74w" name="icons" multiple="true"/>
                </expression>
              </parameters>
            </configuration>
