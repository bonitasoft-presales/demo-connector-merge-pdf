            <configuration xmi:type="connectorconfiguration:ConnectorConfiguration" xmi:id="_GDbh0Z5rEem2CITl3-3gWg" definitionId="scripting-groovy-script" version="1.0.1" modelVersion="9">
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_GDbh0p5rEem2CITl3-3gWg" key="script">
                <expression xmi:type="expression:Expression" xmi:id="_GDbh055rEem2CITl3-3gWg" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true"/>
              </parameters>
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_GDbh1J5rEem2CITl3-3gWg" key="variables"/>
