            <rightOperand xmi:type="expression:Expression" xmi:id="_sJsMYp5ZEematvoC-gpn8Q" name="extractzipWithPictures()" content="import org.bonitasoft.engine.api.DocumentAPI&#xA;&#xA;import com.bonitasoft.presales.common.utils.ZipUtil&#xA;&#xA;DocumentAPI documentApi = (DocumentAPI) apiAccessor.getProcessAPI()&#xA;ZipUtil.extractZip(documentApi,zipAvatar,&quot;image/jpeg&quot;)" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.List">
