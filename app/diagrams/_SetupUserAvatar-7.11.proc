        <defaultValue xmi:type="expression:Expression" xmi:id="_krJwsL7oEeusMtjrUbf2TQ" name="init_userNames()" content="import org.bonitasoft.engine.identity.User&#xD;&#xA;import org.bonitasoft.engine.identity.impl.UserImpl&#xD;&#xA;import org.bonitasoft.engine.search.SearchOptionsBuilder&#xD;&#xA;&#xD;&#xA;def allUsers = apiAccessor.identityAPI.searchUsers(new SearchOptionsBuilder(0, Integer.MAX_VALUE).done())&#xD;&#xA;def allUsersList = []&#xD;&#xA;allUsers.result.each {&#xD;&#xA;        User user ->&#xD;&#xA;        allUsersList.add(&quot;${user.userName}&quot; as String)&#xD;&#xA;}&#xD;&#xA;allUsersList" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.util.List">
